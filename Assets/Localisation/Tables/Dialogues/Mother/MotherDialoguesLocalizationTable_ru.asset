      \u043C\u0430\u043C...\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921027
    m_Localized: "\u0410\u043D\u043D\u0430: ..."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921028
    m_Localized: "(\u041A\u0435\u0442\u0440\u0438\u043D \u0441\u044A\u0435\u0434\u0430\u0435\u0442
      \u043A\u0430\u0448\u0443 \u0413\u043E\u043B\u043E\u0434 + 30, + 10 \u043C\u0438\u043D\u0443\u0442)."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921029
    m_Localized: "\u0412\u044B\u043F\u0438\u0442\u044C \u0447\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921030
    m_Localized: "(\u0433\u043E\u043B\u043E\u0434 +10, \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      +5)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921031
    m_Localized: "\u0412\u044B\u043F\u0438\u0442\u044C \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921032
    m_Localized: "(\u0433\u043E\u043B\u043E\u0434 +1, \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      -1)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921033
    m_Localized: "\u0421\u044A\u0435\u0441\u0442\u044C \u0432\u0430\u0444\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921034
    m_Localized: "(\u0433\u043E\u043B\u043E\u0434 +5 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      +10)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921035
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0441\u0442\u0430\u0449\u0438\u0442\u044C
      \u043F\u0430\u0440\u0443 \u0432\u0430\u0444\u0435\u043B\u044C \u0438\u0437
      \u0432\u0430\u0437\u043E\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921036
    m_Localized: "\u042D\u0442\u043E 60% \u0432\u0430\u0440\u0438\u0430\u043D\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921037
    m_Localized: "(+ 2 \u0432\u0430\u0444\u043B\u0438 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u0445)
      // 60%"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921038
    m_Localized: "\u042D\u0442\u043E 40% \u0432\u0430\u0440\u0438\u0430\u043D\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921039
    m_Localized: "\u0410\u043D\u043D\u0430: \u0420\u0438\u043D, \u043F\u0440\u0430\u0432\u043E
      \u0441\u043B\u043E\u0432\u043E, \u0442\u044B \u0431\u0435\u0437 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u044F
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C \u0440\u0430\u0441\u0442\u0443\u0449\u0438\u0439,
      \u043D\u043E \u043D\u0435 \u043F\u043E\u043C\u043D\u044E, \u0447\u0442\u043E
      \u0431\u044B \u044F \u0432\u043E\u0441\u043F\u0438\u0442\u044B\u0432\u0430\u043B\u0430
      \u0412\u0430\u043B\u043B\u0430\u0440\u0430 \u041C\u0438\u0437\u0430\u0440\u0430
      - \u0437\u0430\u043F\u0430\u0441\u043B\u0438\u0432\u043E\u0433\u043E \u0445\u043E\u0440\u044C\u043A\u0430.
      // 40%"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921040
    m_Localized: "\u0412\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u0432\u0430\u0444\u043B\u044E \u0432 \u043A\u0430\u0440\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921041
    m_Localized: "(+2 \u0432\u0430\u0444\u043B\u0438 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435,
      -3 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921042
    m_Localized: "-\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0443\u043C\u0430\u043B\u0430
      \u043A\u0430\u043A \u0431\u044B  \u0435\u0435 \u0441\u044A\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921043
    m_Localized: "\u0410\u043D\u043D\u0430: \u0412\u043E\u0442 \u043A\u0430\u043A...
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439 \u043C\u043D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E
      \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043D\u0435
      \u044E\u043D\u043E\u0439 \u043B\u0435\u0434\u0438  \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u043F\u0435\u0440\u0435\u0431\u0430\u0440\u0449\u0438\u0432\u0430\u0442\u044C
      \u0441\u043E \u0441\u043B\u0430\u0434\u043A\u0438\u043C  \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A...
      \u041D\u043E \u044E\u043D\u043E\u0439 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u0446\u0435
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043C\u043D\u043E\u0433\u043E
      \u0441\u0438\u043B... \u0410 \u0442\u0435\u0431\u0435 \u043E\u043D\u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921044
    m_Localized: "(\u0441\u044A\u0435\u0434\u0430\u0435\u0442 \u0432\u0430\u0444\u043B\u0438 
      +10 \u0433\u043E\u043B\u043E\u0434, +10 \u043C\u0438\u043D\u0443\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921045
    m_Localized: "\u0410\u043D\u043D\u0430: \u041E\u0441\u0435\u043D\u043D\u044F\u044F
      \u0433\u0435\u043D\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430,
      \u0420\u0438\u043D\u043D. (\u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921046
    m_Localized: "\u041A\u0435\u0442: \u041E\u0441\u0435\u043D\u043D\u044F\u044F
      \u0443\u0431\u043E\u0440\u043A\u0430... (\u0425\u043C\u0443\u0440\u043E \u0431\u0435\u0437
      \u044D\u043D\u0442\u0443\u0437\u0438\u0430\u0437\u043C\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921047
    m_Localized: "\u0410\u043D\u043D\u0430: \u041D\u0435 \u0441\u043B\u044B\u0448\u0443
      \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E\u0433\u043E \u0437\u0430\u0434\u043E\u0440\u0430.
      \u0432 \u0442\u0432\u043E\u0435\u043C \u0433\u043E\u043B\u043E\u0441\u0435,
      \u043C\u0438\u043B\u0430\u044F.  \u0418\u0442\u0430\u043A \u043F\u0440\u0438\u0448\u043B\u043E
      \u0432\u0440\u0435\u043C\u044F \u0443\u0431\u043E\u0440\u043A\u0438, \u0430
      \u0442\u0432\u043E\u0439 \u043E\u0442\u0435\u0446 \u043E\u043F\u044F\u0442\u044C
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u043E\u0441\u043E\u0431\u043E \u0432\u0430\u0436\u043D\u044B\u0439 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442. 
      \u0422\u044B \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
      \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
      \u044D\u0442\u0430 \u0437\u043B\u043E\u0432\u0435\u0449\u0443\u044E \u0430\u0443\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921048
    m_Localized: "\u041A\u0435\u0442: ... \u041D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921049
    m_Localized: "\u0410\u043D\u043D\u0430: \u0421\u043B\u043E\u0432\u043E\u043C
      \u043D\u0430\u0441\u0442\u0430\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F
      \u0443\u0431\u043E\u0440\u043A\u0438. \u0421\u043F\u0435\u0440\u0432\u0430
      \u0437\u0430\u0439\u043C\u0438\u0441\u044C \u0433\u043E\u0441\u0442\u0438\u043D\u043E\u0439...
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0441 \u043A\u043B\u0430\u0432\u0435\u0441\u0438\u043D\u043E\u043C 
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435...
      \u043D\u0435\u0434\u043E\u0440\u0430\u0437\u0443\u043C\u0435\u043D\u0438\u0435.
      \u041F\u0440\u0438\u0431\u0435\u0440\u0438 \u0442\u0430\u043C \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921050
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0441\u0445\u043E\u0434\u0438 \u043D\u0430
      \u043E\u0433\u043E\u0440\u043E\u0434 \u0437\u0430 \u0437\u0435\u043B\u0435\u043D\u044C\u044E.
      \u0413\u043E\u0441\u043F\u043E\u0436\u0430 \u041C\u0430\u0440  \u0431\u044B\u043B\u0430
      \u0442\u0430\u043A \u0434\u043E\u0431\u0440\u0430, \u0447\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u043D\u0430\u043C \u0433\u043E\u0441\u0442\u0438\u043D\u0435\u0446. \u041F\u0430\u0440\u0443
      \u043A\u0443\u0440. \u0418\u0445 \u043D\u0430\u0434\u043E \u0437\u0430\u043C\u0430\u0440\u0438\u043D\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921051
    m_Localized: "\u0415\u0449\u0435 \u043D\u0430 \u0431\u0430\u043D\u0435 \u043A\u0430\u043A
      \u0431\u0443\u0434-\u0442\u043E \u0431\u044B \u0441\u0433\u043E\u0440\u0435\u043B
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B \u0431\u0443\u0440\u044C .
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0441\u043B\u043E\u0436\u043D\u043E
      \u2013 \u043F\u043E\u043C\u0435\u043D\u044F\u0439. \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0432  \u044F\u0449\u0438\u043A\u0435 
      \u043D\u0430 \u0447\u0435\u0440\u0434\u0430\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921052
    m_Localized: "\u0415\u0449\u0435 \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439
      \u0434\u0435\u043A\u0430\u0434\u0435 \u044F \u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u0442\u0432\u043E\u0435\u0433\u043E \u043E\u0442\u0446\u0430 \u0441\u043C\u0430\u0437\u0430\u0442\u044C 
      \u043A\u043E\u043B\u0435\u0441\u0430 \u043A\u043E\u043B\u043E\u0434\u0446\u0430,
      \u043E\u0447\u0435\u043D\u044C \u0443\u0436 \u0436\u0430\u043B\u043E\u0431\u043D\u043E
      \u043E\u043D\u0438 \u0437\u0430\u0432\u044B\u0432\u0430\u043B\u0438 \u043F\u043E
      \u0432\u0435\u0447\u0435\u0440\u0430\u043C,  \u043D\u043E \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0438 \u0441 \u043D\u0438\u043C\u0438 \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0448\u043B\u043E
      \u043D\u0435 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921053
    m_Localized: "\u041A\u0435\u0442: \u041C\u0430\u043C... \u043F\u043E\u0434 \u043D\u0435\u0434\u043E\u0440\u0430\u0437\u0443\u043C\u0435\u043D\u0438\u044F\u043C\u0438
      \u0442\u044B \u0438\u043C\u0435\u0435\u0448\u044C \u0432\u0432\u0438\u0434\u0443
      \u0412\u0438\u043B\u0432\u0430\u0440\u0438\u043D? ( \u0425\u043C\u0443\u0440\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921054
    m_Localized: "\u0410\u043D\u043D\u0430: \u041F\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0439
      \u0447\u0430\u0441\u0442\u0438... \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0411\u0435\u043B, \u0410\u0441\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0438, \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u0438
      \u0438 \u043F\u0440\u043E\u0447\u0438\u0435 \u043E\u0431\u0438\u0442\u0430\u043B\u0438
      \u0445\u0430\u043B\u0434\u043D\u043E\u0433\u043E \u043C\u0438\u0440\u0430.
      \u041A\u0430\u043A \u044F \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
      \u044D\u043A\u0441\u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0442 \u0442\u0432\u043E\u0435\u0433\u043E
      \u043E\u0442\u0446\u0430   \u0438 \u0432\u043F\u0440\u0430\u0432\u0434\u0443
      \u043A\u0440\u0430\u0446\u043D\u0435 \u0432\u0430\u0436\u043D\u044B\u0439 (\u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430
      \u0438 \u0441\u0430\u0440\u043A\u0430\u0442\u0441\u0438\u0447\u043D\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921055
    m_Localized: "\u041A\u0435\u0442:  \u0412\u043E\u0442 \u043E\u043D\u043E \u043A\u0430\u043A...
      \u0437\u043D\u0430\u0447\u0438\u0442   \u043C\u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0438\u0437\u0433\u043D\u0430\u0442\u044C \u0438\u0445? (\u0427\u0443\u0442\u044C
      \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0430\u043B)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921056
    m_Localized: "\u0410\u043D\u043D\u0430: \u041D\u043E \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430
      \u043D\u0435 \u0443\u0432\u043B\u0435\u043A\u0430\u0439\u0441\u044F.  \u0418
      \u0435\u0441\u043B\u0438 \u0442\u0430\u043C \u0431\u0443\u0434\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u0438 \u043F\u0440\u0430\u0432\u0434\u0430
      \u043E\u043F\u0430\u0441\u043D\u043E\u0435... \u043A\u043E\u0435 \u043A\u0442\u043E
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u043F\u043E \u0441\u0432\u043E\u0435\u0439
      \u043A\u0443\u0434\u0440\u044F\u0432\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921057
    m_Localized: "\u041A\u0435\u0442: \u041F\u043E\u0441\u0442\u0430\u0440\u0430\u044F\u044E\u0441\u044C,
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043B\u043E\u043C\u0430\u0442\u044C.
      \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u0447\u0442\u043E-\u0442\u043E \u0435\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921058
