  m_TableData:
  - m_Id: 1553259294720
    m_Localized: "\u0410\u043D\u043D\u0430: \u0420\u0438\u043D\u043D\u0438, \u0443\u0436\u0435
      \u0437\u0430 \u043F\u043E\u043B\u0434\u0435\u043D\u044C, \u0432\u0441\u0442\u0430\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 23782009335808
    m_Localized: "\u041A\u0435\u0442: <color=#ff0000> \u041D\u0435 \u0445\u043E\u0447\u0443...
      </color>"
    m_Metadata:
      m_Items: []
  - m_Id: 130460918738944
    m_Localized: "\u0410\u043D\u043D\u0430: \u0420\u0438\u043D\u043D\u0438, \u043C\u043D\u0435
      \u0436\u0435 \u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C \u0442\u0440\u0435\u0442\u0438\u0439
      \u0440\u0430\u0437..."
    m_Metadata:
      m_Items: []
  - m_Id: 130460922933248
    m_Localized: "\u041A\u0435\u0442: \u041D\u0443 \u041C\u0430-\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 142308439224320
    m_Localized: "\u0410\u043D\u043D\u0430: \u0422\u043E \u0447\u0442\u043E \u0442\u044B
      \u0447\u0438\u0442\u0430\u043B\u0430 \u0434\u043E\u043F\u043E\u0437\u0434\u043D\u0430,
      \u0435\u0449\u0435 \u043D\u0435 \u043F\u043E\u0432\u043E\u0434 \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C
      \u043A \u0443\u0436\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248896
    m_Localized: "\u041D\u043E \u044D\u0442\u043E \u0438 \u043D\u0435 \u043F\u043E\u0432\u043E\u0434
      \u0431\u0443\u0434\u0438\u0442\u044C, (\u0445\u043C\u0443\u0440\u043E \u0431\u0443\u0440\u043A\u043D\u0443\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248897
    m_Localized: "\u0410\u043D\u043D\u0430: \u0413\u043E\u0441\u043F\u043E\u0436\u0435
      \u0420\u0435\u043D\u0441, \u0432\u044B \u0438 \u043F\u0440\u0430\u0432\u0434\u0430
      \u0438\u0437\u0430\u043B\u043E\u0432\u0430\u043D\u0430\u044F \u0430\u0440\u0438\u0441\u0442\u043E\u043A\u0440\u0430\u0442\u043A\u0430,
      \u043D\u043E, \u0431\u043E\u044E\u0441\u044C \u0433\u043E\u0440\u0438\u0447\u043D\u044B\u0445
      \u0447\u0442\u043E  \u043F\u043E\u0434\u043D\u0438\u043C\u0443\u0442 \u0438
      \u043E\u0434\u0435\u043D\u0443\u0442 \u0432\u0430\u0441, \u0440\u0430\u0432\u043D\u043E
      \u043A\u0430\u043A \u0438 \u0441\u0434\u0435\u043B\u0430\u044E\u0442 \u0432\u0441\u0435
      \u0432\u0430\u0448\u0438 \u0434\u0435\u043B\u0430, \u0432 \u044D\u0442\u043E\u043C
      \u0434\u043E\u043C\u0435 \u043D\u0435 \u0432\u043E\u0434\u0438\u0442\u0441\u044F.
      (\u0410\u043D\u043D\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0438\u0434 \u0440\u0430\u0437\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0439
      \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0441\u0441\u0441\u0435\u0440\u0436\u0435\u043D\u043D\u044B\u0439)"
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248898
    m_Localized: "\u041A\u0435\u0442: \u0414\u0435\u043B\u0430... \u043A\u0430\u043A\u0438\u0435
      \u0434\u0435\u043B\u0430? (\u041A\u0435\u0442 \u0440\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0430,
      \u043E\u0431\u0438\u0436\u0435\u043D\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248899
    m_Localized: "\u0410\u043D\u043D\u0430: \u0423\u0437\u043D\u0430\u0435\u0442\u0435
      \u043A\u043E\u0433\u0434\u0430 \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u0435\u0441\u044C
      \u043E\u0442\u0432\u0435\u0434\u0430\u0442\u044C \u0432\u0430\u0448\u0435\u0439
      \u043E\u0432\u0441\u044F\u043D\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248900
    m_Localized: "(\u0410\u043D\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u043A\u043E\u043C\u043D\u0430\u0442\u044B, \u0441\u0442\u0443\u043A\u043D\u0443\u0432
      \u0434\u0432\u0435\u0440\u044C\u044E \u0447\u0443\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u0438\u0438
      \u0447\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248901
    m_Localized: "(\u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F -5, \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      -15)"
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248902
    m_Localized: "\u041B\u0430\u0434\u043D\u043E \u043B\u0430\u0434\u043D\u043E...
      \u0437\u0435\u0432\u043E\u043A... \u0441\u0435\u0439\u0447\u0430\u0441 \u0443\u0436\u0435
      \u0432\u0441\u0442\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248903
    m_Localized: "\u0410\u043D\u043D\u0430: \u041D\u0430\u0434\u0435\u044E\u0441\u044C
      \u0447\u0442\u043E \u0442\u0430\u043A, \u0420\u0438\u043D\u043D\u0438. \u041A\u0430\u0448\u0430
      \u0443\u0436\u0435  \u043F\u043E\u0447\u0442\u0438 \u043E\u0441\u0442\u044B\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248904
    m_Localized: "\u041A\u0435\u0442: \u041A\u0430\u0448\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248905
    m_Localized: "\u0410\u043D\u043D\u0430: \u041F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0441\u044C. 
      \u0411\u044B\u043B\u043E \u0431\u044B \u0441\u043B\u0430\u0432\u043D\u043E,
      \u043D\u043E \u0435\u0434\u0432\u0430 \u043B\u0438 \u0434\u043E\u043C \u0441\u0430\u043C
      \u0441\u0435\u0431\u044F \u0443\u0431\u0435\u0440\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248906
    m_Localized: "\u041A\u0435\u0442: \u0423\u0431\u043E\u0440\u043A\u0430 \u0437\u043D\u0430\u0447\u0438\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248907
    m_Localized: "\u0410\u043D\u043D\u0430: \u0412\u0441\u0435 \u043E\u0434\u043D\u043E
      \u0434\u0435\u043B \u0443 \u0442\u0435\u0431\u044F \u043A\u0430\u043A \u0431\u0443\u0434-\u0442\u043E
      \u0431\u044B \u043D\u0435\u0442. \u0416\u0434\u0443 \u0442\u0435\u0431\u044F
      \u043D\u0430 \u043A\u0443\u0445\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248908
    m_Localized: "(\u0410\u043D\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F -1)"
    m_Metadata:
      m_Items: []
  - m_Id: 142384855248909
    m_Localized: "\u041C\u043E\u043B\u0447\u0430 \u0437\u0430\u0432\u0430\u043B\u0438\u0442\u0441\u044F
      \u0441\u043F\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344064
    m_Localized: "(\u044D\u043A\u0440\u0430\u043D \u0432\u043D\u043E\u0432\u044C
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0437\u0430\u0442\u0435\u043C\u043D\u0435\u043D\u0438\u0435
      \u043D\u043E \u0441\u043F\u0443\u0441\u0442\u044F \u043F\u0430\u0440\u0443
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439 \u2013 \u044F\u0440\u043A\u0430\u044F
      \u0432\u0441\u043F\u044B\u0448\u043A\u0430 \u043C\u0430\u0433\u0438\u0438)"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344065
    m_Localized: "\xAB\u0411\u0410\u0426\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344066
    m_Localized: "(-5 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344067
    m_Localized: "\u041A\u0435\u0442: \u0411\u043E\u043B\u044C\u043D\u043E \u0432\u0435\u0434\u044C!
      (\u043E\u0431\u0438\u0436\u0435\u043D\u043E \u0440\u0430\u0437\u0430\u0437\u043B\u0435\u043D\u043D\u043E.
      \u0432 \u043A\u0440\u0430\u0448\u0435\u043A\u0430\u0445 \u0433\u043B\u0430\u0437
      \u0441\u043B\u0435\u0437\u044B)"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344068
    m_Localized: "\u0410\u043D\u043D\u0430:\u0411\u043E\u044E\u0441\u044C \u0432\u044B
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043C\u043D\u0435
      \u0438\u043D\u043E\u0433\u043E \u0432\u044B\u0431\u043E\u0440\u0430, \u0433\u043E\u0441\u043F\u043E\u0436\u0430
      \u0420\u0435\u043D\u0441. (\u0410\u043D\u043D\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0443\u0445\u0430 \u0434\u043E \u0443\u0445\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344069
    m_Localized: "\u041A\u0435\u0442: \u041D\u043E... \u044F \u0432\u0435\u0434\u044C
      \u043D\u0438\u0447\u0435\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0435
      \u0441\u0434\u0435\u043B\u0430\u043B\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344070
    m_Localized: "\u0410\u043D\u043D\u0430: \u0427\u0442\u043E \u043D\u0435\u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E
      \u0434\u043B\u044F \u0441\u0442\u043E\u043B\u044C \u0432\u0435\u043B\u0438\u043A\u043E\u0439
      \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u0446\u044B \u043A\u0430\u043A
      \u0432\u044B, \u0433\u043E\u0441\u043F\u043E\u0436\u0430 \u0420\u0435\u043D\u0441.
      \u0412 \u0432\u0430\u0448\u0435\u043C \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435
      \u0438 \u043D\u0435\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0449\u0438\u0442
      \u043D\u0430 \xAB\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
      \u0449\u0435\u043B\u0431\u0430\u043D \u0410\u0440\u0445\u0438\u043C\u0430\u0433\u0430
      \u0413\u0435\u0439\u043B\u0443\u0441\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344071
    m_Localized: "\u041A\u0435\u0442:\u0411\u0443\u0434\u0442\u043E \u2013 \u0431\u044B
      \u044F \u043C\u043E\u0433\u0443... (\u0441\u043E\u0432\u0441\u0435\u043C \u0445\u043C\u0443\u0440\u043E
      \u043F\u0440\u043E\u0431\u043E\u043C\u0442\u0430\u043B\u0430 \u041A\u0435\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344072
    m_Localized: "\u0410\u043D\u043D\u0430: \u0435\u0441\u043B\u0438 \u0432\u044B
      \u043D\u0435 \u0441\u0442\u043E\u043B\u044C \u0432\u044B\u0434\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u043C\u0430\u0433 \u2013 \u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F
      \u0441\u043F\u0443\u0441\u0442\u0441\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0437\u0430\u0432\u0442\u0440\u0430\u0432\u0430\u0442\u044C
      \u0438 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u043A
      \u043E\u0441\u0435\u043D\u043D\u0435\u0439 \u0443\u0431\u043E\u0440\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344073
    m_Localized: "(\u0410\u043D\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u2013 8, \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435
      -5, \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 -5)"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344074
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0437\u0430\u0441\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344075
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344076
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0437\u0430\u0441\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344077
    m_Localized: " +10 \u043C\u0438\u043D\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344078
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u0449\u0435\u043B\u0431\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344079
    m_Localized: "(\u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 -5, \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F-5,
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 -5)"
    m_Metadata:
      m_Items: []
  - m_Id: 149415104344080
    m_Localized: "(\u041F\u043E\u043B\u0443\u0447\u0435\u043D \u043A\u0432\u0435\u0441\u0442:
      \"\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u0437\u0430\u0432\u0442\u0440\u0430\u043A\".)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921024
    m_Localized: "\u041A\u0435\u0442: \xAB\u0418 \u0432\u043D\u043E\u0432\u044C \u043A\u0430\u0448\u0430...
      \u0438 \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u0432\u043E\u044F \u043C\u0430\u043C\u0430
      \u0442\u0430\u043A \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0447\u0442\u043E
      \u043E\u043D\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u0430 \u0434\u043B\u044F
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F?\xBB (\u0425\u043C\u0443\u0440\u043E\u0435
      \u043B\u0438\u0446\u043E (\u043F\u043E\u0434\u043F\u0435\u0440\u0435\u0432
      \u0449\u0435\u043A\u0443)"
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921025
    m_Localized: "\u0410\u043D\u043D\u0430: \u041F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043E\u043D\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u0430,
      \u0420\u0438\u043D\u043D\u0438. (\u0410\u043D\u043D\u0430 \u0441 \u043B\u0435\u0433\u043A\u043E\u0439
      \u0443\u043B\u044B\u0431\u043A\u043E\u0439)."
    m_Metadata:
      m_Items: []
  - m_Id: 158480001921026
    m_Localized: "\u041A\u0435\u0442: \xAB\u0418 \u0432\u0440\u0430\u0433\u0443 \u043D\u0435
      \u043F\u043E\u0436\u0435\u043B\u0430\u0435\u0448\u044C \u0436\u0438\u0442\u044C
      \u0432 \u0441\u0435\u043C\u044C\u0435 \u0447\u0442\u0435\u0446\u043E\u0432
