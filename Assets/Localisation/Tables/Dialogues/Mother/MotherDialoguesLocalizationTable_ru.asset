      m_Items: []
  - m_Id: 158480001921064
    m_Localized: "\u0410\u043D\u043D\u0430: \u0418 \u0435\u0449\u0435 \u043A\u043E\u0435
      \u0447\u0442\u043E. \u041A\u0440\u0430\u0439\u043D\u0435 \u0432\u0430\u0436\u043D\u044B\u0435
      \u044D\u043A\u0441\u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0442\u044B \u0442\u0432\u043E\u0435\u0433\u043E
      \u043E\u0442\u0446\u0430, \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F
      \u043F\u043E\u0434\u043A\u043E\u0440\u043C\u043A\u0430 \u0434\u043B\u044F \u0441\u0435\u0440\u043E\u0433\u043E
      \u043C\u0445\u0430. \u0422\u044B \u0435\u0433\u043E \u0432\u0438\u0434\u0438\u0448\u044C
      \u043B\u0443\u0447\u0448\u0435 \u043C\u043E\u0435\u0433\u043E, \u0442\u0430\u043A
      \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0435\u043F\u043B\u043E\u0445\u043E
      \u0438 \u0435\u0433\u043E \u043F\u0440\u0438\u0431\u0440\u0430\u0442\u044C."
